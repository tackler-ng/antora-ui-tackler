      <div class="navbar-item">
        <a href="https://tackler.fi">Tackler</a>
        <span class="separator">//</span>
        <a href="{{or site.url (or siteRootUrl siteRootPath)}}">Docs</a>
      </div>
      {{#if env.SITE_SEARCH_PROVIDER}}
